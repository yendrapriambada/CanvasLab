PORT=3000
CANVASLAB_API_URL=https://txsyyhcrtasrqodtvpvn.supabase.co/functions/v1/canvaslab-api
# Set both true behind a trusted HTTPS reverse proxy in production.
COOKIE_SECURE=false
TRUST_PROXY=false

# Server-only private realtime relay, required on Vercel / multiple gateways.
# Configure the real value in your host environment, never commit it.
CANVASLAB_REALTIME_URL=https://txsyyhcrtasrqodtvpvn.supabase.co
CANVASLAB_REALTIME_KEY=

# "Sign in with Google" - a Google Cloud OAuth Client ID (public, safe to
# expose to the browser). Create one at https://console.cloud.google.com/apis/credentials
# (Application type: Web application) and add this app's origin(s) under
# "Authorized JavaScript origins". No client secret is needed: the ID token
# Google returns is verified against Google's own public keys.
# The canvaslab-api Edge Function also needs the SAME value as its own
# GOOGLE_CLIENT_ID secret (`supabase secrets set GOOGLE_CLIENT_ID=...`),
# since that is where the token is actually verified.
VITE_GOOGLE_CLIENT_ID=

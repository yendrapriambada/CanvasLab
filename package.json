{
  "name": "canvaslab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark": "tsx tests/benchmark.ts",
    "seed": "tsx scripts/seed.ts",
    "test:integration": "tsx tests/integration.ts",
    "test:ws": "tsx tests/ws-security.ts",
    "test:restart": "tsx tests/restart-persistence.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "jose": "^6.2.12",
    "lucide-react": "1.42.0",
    "postgres": "3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.3",
    "y-indexeddb": "9.0.12",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.x"
  }
}
